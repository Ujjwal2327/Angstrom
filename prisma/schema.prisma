// prisma/schema.prisma

generator client {
  provider   = "prisma-client-js"
  // Prisma 6 defaults to the WASM engine. For standard Node.js / Vercel
  // deployments the native "library" engine gives better cold-start perf
  // and avoids a separate WASM fetch on each invocation.
  engineType = "library"
}

// `url`       → pooled connection (Neon PgBouncer). Handles all regular queries.
// `directUrl` → direct connection (no pooler). Required for Prisma migrations
//               and interactive $transaction calls that hold a connection open.
// Add DIRECT_URL to your .env — same as DATABASE_URL but without &pgbouncer=true.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique
  email        String       @unique
  firstname    String?
  lastname     String?
  pic          String?
  about        String?
  achievements String?
  profiles     Json?
  skills       String[]
  // Order the 5 public profile sections render in (achievements, experience,
  // projects, skills, education) — user-customizable via the edit form's
  // "arrange sections" control (see constants.js's sectionMeta /
  // defaultSectionOrder, which this default mirrors). "basic info" isn't
  // part of this list since it isn't a section on the public profile.
  sectionOrder String[]     @default(["achievements", "experience", "projects", "skills", "education"])
  projects     Project[]
  education    Education[]
  experience   Experience[]
}

model Project {
  id       Int      @id @default(autoincrement())
  order    Int
  name     String
  live_url String?
  code_url String
  skills   String[]
  about    String
  // Free-form grouping label the user assigns (e.g. "Client Work",
  // "Independent"). Optional and unrestricted on purpose — see
  // components/profile/ProjectsGrid.js: a filter only ever appears once 2+
  // distinct categories are actually in use, so someone with only one kind
  // of project right now isn't nudged into labelling it at all.
  category String?
  userId   Int
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model Education {
  id             Int     @id @default(autoincrement())
  order          Int
  institution    String
  degree         String
  specialization String?
  score          String?
  start          String
  end            String? @default("Present")
  userId         Int
  user           User    @relation(fields: [userId], references: [id])

  @@unique([userId, degree])
}

model Experience {
  id       Int     @id @default(autoincrement())
  order    Int
  company  String
  position String
  start    String
  end      String? @default("Present")
  about    String?
  userId   Int
  user     User    @relation(fields: [userId], references: [id])

  @@unique([userId, company, position])
}
